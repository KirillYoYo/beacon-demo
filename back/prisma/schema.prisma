datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[] // связь

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model City {
  id         Int               @id @default(autoincrement())
  name       String
  country    String
  lat        Float
  lon        Float
  timezone   String? // опционально для сложных прогнозов
  population Int? // для сортировки
  forecasts  WeatherForecast[]

  @@unique([lat, lon])
  @@map("cities")
}

model WeatherForecast {
  id          Int      @id @default(autoincrement())
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  datetime    DateTime // точное время прогноза (UTC)
  temperature Float
  feelsLike   Float?
  humidity    Int?
  pressure    Int?
  windSpeed   Float?
  windDir     Int? // градусы
  description String? // описание погоды
  icon        String? // код иконки (можно маппить)
  source      String? // откуда взято (Open-Meteo)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cityId, datetime])
  @@index([datetime])
  @@map("weather_forecasts")
}

model BeaconRecord {
  id                  Int      @id @default(autoincrement())
  fingerprint         String   @db.Text
  sessionId           String?  @db.Text
  userId              Int? // если есть авторизация
  url                 String?  @db.Text // текущий URL страницы
  referrer            String?  @db.Text // берём с сервера
  screenResolution    String? // "1920x1080"
  colorDepth          Int? // бит на пиксель
  language            String?
  platform            String?
  timezoneOffset      Int? // минуты от UTC
  deviceMemory        Float? // ГБ
  hardwareConcurrency Int?
  touchSupport        Boolean?
  firstPaint          Float? // время в мс
  domReadyTime        Float? // время в мс
  clicksCount         Int? // кол-во кликов
  connectionType      String? // "4g", "wifi" и т.д.
  canvasFingerprint   String? // дополнительный отпечаток
  userAgent           String?  @db.Text // с сервера
  ipAddress           String?  @db.Text // с сервера
  payload             Json?    @db.JsonB // всё остальное
  createdAt           DateTime @default(now()) @map("created_at")
}